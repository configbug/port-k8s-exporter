  {
    "blueprint": "dhh_replicaSet",
    "operation": "create",
    "filter": ".body.action == \"upsert\" and .body.resourceType == \"apps/v1/replicasets\" and (.body.data.metadata.namespace | startswith(\"kube-\") | not)",
    "entity": {
      "identifier": ".body.data.metadata.name + \"-ReplicaSet-\" + .body.data.metadata.namespace + \"-\" + .body.clusterName",
      "title": ".body.data.metadata.name",
      "properties": {
        "creationTimestamp": ".body.data.metadata.creationTimestamp",
        "labels": ".body.data.metadata.labels",
        "replicas": ".body.data.spec.replicas",
        "availableReplicas": ".body.data.status.availableReplicas",
        "containers": ".body.data.spec.template.spec.containers | map({name, image, resources})",
