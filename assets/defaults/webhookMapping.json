  {
    "blueprint": "dhh_pod",
    "operation": "create",
    "filter": ".body.action == \"upsert\" and .body.resourceType == \"v1/pods\" and .body.data.metadata.ownerReferences[0].kind == \"ReplicaSet\" and (.body.data.metadata.namespace | startswith(\"kube-\") | not)",
    "entity": {
      "identifier": ".body.data.metadata.name + \"-\" + .body.data.metadata.namespace + \"-\" + .body.clusterName",
      "title": ".body.data.metadata.name",
      "properties": {
        "startTime": ".body.data.status.startTime",
        "phase": ".body.data.status.phase",
        "labels": ".body.data.metadata.labels",
        "containers": "(.body.data.spec.containers | map({image, resources})) + .body.data.status.containerStatuses | group_by(.image) | map(add)"
      },
      "relations": {
        "replicaSet": ".body.data.metadata.ownerReferences[0].name + \"-ReplicaSet-\" + .body.data.metadata.namespace + \"-\" + .body.clusterName",
        "Node": "if .body.data.spec.nodeName then ((.body.data.spec.nodeName | split(\".\") | join(\"_\")) + \"-\" + .body.clusterName) else null end",
        "Namespace": ".body.data.metadata.namespace + \"-\" + .body.clusterName"
      }
    }
  },

